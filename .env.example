# T.E.A.S 2 Environment Variables
# Copy to .env and fill in at least one LLM API key.

# Interface Mode Configuration
# Options: main (full-featured), minimal (basic), simple (user-friendly)
TAES_INTERFACE_MODE=main

# Server Configuration
TAES_SERVER_NAME=0.0.0.0
TAES_SERVER_PORT=7860
TAES_SHARE_GRADIO=false
TAES_DEBUG=false
# Concurrent evaluations per instance
TAES_CONCURRENCY_LIMIT=4

# Optional login for the web UI (enabled when both are set)
TAES_AUTH_USERNAME=
TAES_AUTH_PASSWORD=

# Database Configuration
# Docker Compose builds DATABASE_URL from these
POSTGRES_DB=taes2_db
POSTGRES_USER=taes2_db_user
# Required: choose a strong value
POSTGRES_PASSWORD=
# pgAdmin login (docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
# Running the app outside Docker? Set DATABASE_URL directly
# (or DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD):
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/taes2_db

# LLM Configuration [Any ONE]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM Settings (any LiteLLM model name)
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=2000
# Comma separated list of models offered in the UI
# MODEL_CHOICES=gpt-4o-mini,gpt-4o,anthropic/claude-3-5-haiku-latest

# Reference material (RAG). Set EMBEDDING_MODEL=none for keyword search only
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3

# Handwriting / scanned documents (empty VISION_MODEL = model selected for grading)
VISION_MODEL=
MAX_OCR_PAGES=20
OCR_RESOLUTION=200

# Application Settings
BATCH_SIZE=32
MAX_UPLOAD_SIZE=100
MAX_FILE_SIZE_MB=50
VECTOR_DIMENSION=384
